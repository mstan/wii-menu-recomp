set(WIILLR_MENU_PICTURES "none" CACHE STRING "Wii Menu native Picture provider: none, declared-slice or strict")
set_property(CACHE WIILLR_MENU_PICTURES PROPERTY STRINGS none declared-slice strict)
if(NOT WIILLR_MENU_PICTURES MATCHES "^(none|declared-slice|strict)$")
  message(FATAL_ERROR "Unknown native Wii Menu Picture provider")
endif()
if(NOT WIILLR_MENU_PICTURES STREQUAL "none")
  if(NOT WIILLR_GX STREQUAL "native-development")
    message(FATAL_ERROR "Native Wii Menu Pictures require the native host renderer")
  endif()
  target_sources(wii_boot PRIVATE native/menu_picture.cpp "${WIILLR_MENU_ROOT}/src/menu_picture_hook.c" "${WIILLR_MENU_ROOT}/src/menu_frame_hook.c")
  if(WIILLR_MENU_PICTURES STREQUAL "strict")
    target_compile_definitions(wii_boot PUBLIC WIILLR_MENU_PICTURES=2)
  else()
    target_compile_definitions(wii_boot PUBLIC WIILLR_MENU_PICTURES=1)
  endif()
else()
  target_compile_definitions(wii_boot PUBLIC WIILLR_MENU_PICTURES=0)
endif()
set(WIILLR_MENU_TEXT "none" CACHE STRING "Menu TextBox provider: none, declared-slice or strict")
set_property(CACHE WIILLR_MENU_TEXT PROPERTY STRINGS none declared-slice strict)
if(NOT WIILLR_MENU_TEXT MATCHES "^(none|declared-slice|strict)$")
  message(FATAL_ERROR "Unknown Menu TextBox provider")
endif()
set(_menu_text_mode 0)
if(NOT WIILLR_MENU_TEXT STREQUAL "none")
  if(WIILLR_MENU_PICTURES STREQUAL "none")
    message(FATAL_ERROR "Native Menu TextBox requires the native Menu recording owner")
  endif()
  target_sources(wii_boot PRIVATE native/menu_text.cpp native/menu_text_draw.cpp "${WIILLR_MENU_ROOT}/src/menu_text_hook.c")
  if(WIILLR_MENU_TEXT STREQUAL "strict")
    set(_menu_text_mode 2)
  else()
    set(_menu_text_mode 1)
  endif()
endif()
# Text mode reuses the existing consumer seam and leaves CPU catalog flags alone.
set_property(SOURCE "${WIILLR_MENU_ROOT}/src/menu_picture_hook.c" "${WIILLR_MENU_ROOT}/src/menu_text_hook.c" APPEND PROPERTY
  COMPILE_DEFINITIONS WIILLR_MENU_TEXT=${_menu_text_mode})
set(WIILLR_MENU_FRAME "none" CACHE STRING "Menu enclosing graphics owner: none, reference or native")
set_property(CACHE WIILLR_MENU_FRAME PROPERTY STRINGS none reference native)
if(NOT WIILLR_MENU_FRAME MATCHES "^(none|reference|native)$" OR
   (NOT WIILLR_MENU_FRAME STREQUAL "none" AND WIILLR_MENU_PICTURES STREQUAL "none"))
  message(FATAL_ERROR "Menu frame ownership requires its native pane recording owner")
endif()
if(NOT WIILLR_MENU_GRID_SOURCE)
  set(WIILLR_MENU_GRID_SOURCE "${WIILLR_MENU_ROOT}/src/menu_grid.c")
endif()
set_property(SOURCE "${WIILLR_MENU_ROOT}/src/menu_frame_hook.c" "${WIILLR_MENU_GRID_SOURCE}" APPEND PROPERTY COMPILE_DEFINITIONS
  WIILLR_MENU_FRAME_MODE=$<STREQUAL:${WIILLR_MENU_FRAME},native>)
option(WIILLR_MENU_TRANSFORM "Certified zero-angle Menu Pane matrix stage" OFF)
if(WIILLR_MENU_TRANSFORM)
  if(NOT WIILLR_MENU_FRAME STREQUAL "native")
    message(FATAL_ERROR "Native Menu transform requires the native frame owner")
  endif()
  target_sources(wii_boot PRIVATE "${WIILLR_MENU_ROOT}/native/menu_transform.cpp")
endif()
set_property(SOURCE "${WIILLR_MENU_ROOT}/src/menu_frame_hook.c" "${WIILLR_MENU_GRID_SOURCE}" APPEND PROPERTY COMPILE_DEFINITIONS
  WIILLR_MENU_TRANSFORM=$<BOOL:${WIILLR_MENU_TRANSFORM}>)
target_sources(wii_boot PRIVATE "${WIILLR_MENU_GRID_SOURCE}")
set_property(SOURCE src/gx.c APPEND PROPERTY COMPILE_DEFINITIONS
  WIILLR_MENU_FRAME_ACTIVE=$<NOT:$<STREQUAL:${WIILLR_MENU_FRAME},none>>)

